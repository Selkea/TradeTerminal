#pragma once
// Generated at build time by cmake/git_commit.cmake — records the exact source
// the running binary was built from, surfaced in /diag so you can confirm
// what's actually deployed on the VPS. configure_file only rewrites this when
// the values change, so it doesn't force needless rebuilds.
#define TT_GIT_COMMIT "@TT_GIT_COMMIT@"
#define TT_GIT_DIRTY @TT_GIT_DIRTY@
#define TT_BUILD_DATE "@TT_BUILD_DATE@"
// Human-readable version: "<base> (build <commit-count>)", e.g.
// "0.1.0 (build 412)". The base comes from the CMake project() VERSION; the
// build number is the branch's commit count. TT_GIT_COMMIT stays the source of
// truth for the GitHub update check (SHA compare).
#define TT_VERSION "@TT_VERSION@"
#define TT_BUILD_NUMBER "@TT_BUILD_NUMBER@"
// Base semver (from the CMake project() VERSION) and the build number split out,
// for composing "<base> (<n>)" version strings (e.g. the update panel).
#define TT_VERSION_BASE "@TT_BASE_VERSION@"
// owner/repo of origin, for the GitHub "update available" check.
#define TT_REPO_SLUG "@TT_REPO_SLUG@"
